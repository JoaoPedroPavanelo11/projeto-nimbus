# Banco de dados (os valores batem com o docker-compose.yml da raiz)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nimbus

# Autenticacao - troque por uma chave longa e aleatoria
JWT_SECRET=troque_por_uma_chave_secreta

# Porta da API (opcional, padrao 3000)
PORT=3000

# Primeiro admin, criado pelo comando `npm run seed`
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@nimbus.com
ADMIN_SENHA=troque_esta_senha
